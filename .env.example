# Copy to .env for local development. Never commit .env.

# Local dev: leave as-is to use an embedded Postgres (PGlite) stored in ./.data
# Production: Supabase -> Project Settings -> Database -> Connection string ->
#   "Session pooler" (port 5432, IPv4-compatible). Example:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=pglite:./.data/pglite

# Random string (>=16 chars). cron-job.org sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Password for dashboard actions that change state (follow/unfollow, hide, hedge, reset, settings).
# Without it, local development is open and production is locked.
ADMIN_PASSWORD=

# The server runs the copy engine itself (real-time feed + checks every 15/30/60 s).
# Set to "off" to rely only on cron-job.org calling /api/cron/tick.
ENGINE_LOOP=
